# DiagnosticPro Environment Variables
# =====================================
# NEVER commit real plaintext values! Copy this to .env for local dev, and keep
# the real values in the SOPS-encrypted .env.sops (age) which IS committed and is
# materialized on the VPS at deploy time via scripts/sops-env.
# See README.md for setup instructions.

# Frontend API base. For the self-hosted VPS build, leave EMPTY so the browser
# calls the API same-origin (Caddy proxies /saveSubmission, /analyzeDiagnostic,
# /stripeWebhookForward, etc. to the backend). Only set an absolute URL for
# cross-origin/local-dev against a remote backend.
VITE_USE_NEW_API=true
VITE_API_BASE=

# Stripe Payment Processing (Required)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Whop subscription ($29/mo) — required for Whop membership access.
WHOP_API_KEY=your-whop-api-key
WHOP_WEBHOOK_SECRET=your-whop-webhook-secret

# LLM — OpenAI gpt-4o is the default (OpenAI-compatible client).
# Provider is fully env-driven, so switching is a config change, not a code change.
LLM_API_KEY=your-openai-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Alternative provider examples (just change the three LLM_* vars above):
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1     + GROQ_API_KEY
#   Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1          + any pulled model
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com         + DEEPSEEK_API_KEY
# These key names are also honored as fallbacks for LLM_API_KEY:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# Vision — optional post-pay photo captioning for evidence/photos.
# Reuses LLM_API_KEY / LLM_BASE_URL when VISION_* is unset, so an existing
# OpenAI key already covers both text and image. Default model is gpt-4o
# (the multimodal checkpoint most reliable on damaged-equipment photos).
VISION_MODEL=gpt-4o
# VISION_API_KEY=          (defaults to LLM_API_KEY; OPENAI_API_KEY; etc.)
# VISION_BASE_URL=         (defaults to LLM_BASE_URL)

# Optional: Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Development Settings
NODE_ENV=development
PORT=8080

# Self-host SQLite + local report FS (VPS / docker volume — no GCS, no Firestore)
DB_PATH=/data/diagnosticpro.db
REPORTS_DIR=/data/diagnosticpro/reports
