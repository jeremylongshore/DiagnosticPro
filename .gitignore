# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Self-host runtime artifacts (SQLite DB, generated PDF reports) — never committed;
# these live on the VPS volume at runtime, not in source.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
reports/
02-src/**/reports/
test-results/
playwright-report/

# Aborted git-filter-branch scratch dir (must never be tracked)
.git-rewrite/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables - NEVER commit real (plaintext) values!
.env
.env.*
*.env
!.env.example
!.env.template
# SOPS-encrypted secrets ARE committed (age-encrypted, safe in git) — this is
# the self-host secret source of truth materialized on the VPS at deploy time.
!.env.sops
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc.local
.firebase-debug-token

# Supabase
.supabase/

# Google Cloud Credentials (NEVER commit these)
*.json
!package.json
!package-lock.json
!tsconfig.json
!firebase.json
!.firebaserc
!**/config/*.json
# Live-journey per-run results are the durable evidence trail (no secrets inside)
!tests/live/*.json
# Prompt-eval corpus/outputs/results — the frozen A/B evidence for framework v3 (no secrets)
!tests/prompt-eval/**/*.json
*.key
*.pem
*.p12
*-key.json
*-deployer-key.json
service-account*.json
gcp-*.json

# Secrets and API keys - Comprehensive blocking
**/secrets.js
**/secrets.ts
**/secrets.json
**/*secret*
**/*credential*
**/*token*
!**/node_modules/**
credentials.json
auth.json

# Terraform state (contains secrets)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Temporary/archive folders with potential secrets
claudes-shit/
archive/backups-*/

# Exclude diagnostic-platform directory (separate project)
diagnostic-platform/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
coverage/
