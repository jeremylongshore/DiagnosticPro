{
  "name": "diagnosticpro-backend",
  "version": "2.3.0",
  "description": "DiagnosticPro $4.99 Universal Equipment Diagnostics API (OpenAI gpt-4o via OpenAI-compatible client; self-hosted on VPS, no GCP)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "multer": "^2.0.2",
    "openai": "^4.52.0",
    "pdfkit": "^0.14.0",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "@intentsolutions/audit-harness": "^1.2.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
    "engines": {
     "node": ">=20.0.0"
   },
   "jest": {
     "testEnvironment": "node",
     "testPathIgnorePatterns": [
       "/node_modules/",
       "/__tests__/helpers/",
       "/__tests__/fixtures/"
     ],
     "collectCoverageFrom": [
       "index.js",
       "db.js",
       "reportPdfProduction.js",
       "config/secrets.js"
     ],
     "coverageThreshold": {
       "global": {
         "lines": 60
       }
     },
     "maxWorkers": 1
   },
   "license": "AGPL-3.0-only"
  }
